{
	"project": "normastars",
	"log_level": "info",
	"log_mode": "json",
	"print_conf": true,
	"enable_metric": true,
	"env": "dev",
	"http_server": {
		"enable": true,
		"enable_cors": false,
		"disable_req_log": false,
		"configs": [{
			"name": "server",
			"port": ":8080"
		}, {
			"name": "metrics",
			"port": ":9090"
		}]
	},
	"http_client": {
		"disable_req_log": false,
		"enable_metric": true
	},
	"mysql": {
		"enable": false,
		"disable_req_log": true,
		"configs": []
	},
	"redis": {
		"enable": false,
		"disable_req_log": true,
		"configs": []
	}
}
